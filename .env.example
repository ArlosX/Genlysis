HOST=127.0.0.1
PORT=4181
DATA_DIR=./data
# Optional server-only token increases GitHub API quota. Never use a VITE_ name.
GITHUB_TOKEN=
GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Set after deploying contracts/genlysis.py. Frontend reads this from the API.
